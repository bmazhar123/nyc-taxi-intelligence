{
  "name": "NYC Taxi Intelligence",
  "dataColors": ["#1F3A5F", "#F2A900", "#3E7CB1", "#8FB8DE", "#6B7280", "#C2410C", "#2E7D5B", "#B8C4D6"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#F2A900",
  "good": "#2E7D5B",
  "neutral": "#6B7280",
  "bad": "#C2410C",
  "maximum": "#1F3A5F",
  "center": "#8FB8DE",
  "minimum": "#F1F5F9",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4B5563" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F6F8" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
